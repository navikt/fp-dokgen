{{~#*inline "felles-konto"~}}
{{#switch søker.kontoType}}
    {{~#case "FEDREKVOTE"~}}{{#eq @root.rolle "MEDMOR"}}Medmorkvote{{else}}Fedrekvote{{/eq}}{{~/case~}}
    {{~#case "MØDREKVOTE"~}}Mødrekvote{{~/case~}}
    {{~#case "FELLESPERIODE"~}}Fellesperiode{{~/case~}}
    {{~#case "FORELDREPENGER_FØR_FØDSEL"~}}Foreldrepenger før fødsel{{~/case~}}
    {{~#case "FORELDREPENGER"~}}Foreldrepenger{{~/case~}}
{{/switch}}
{{~/inline~}}
{{~#*inline "felles-mors-aktivitet"~}}
{{#switch søker.morsAktivitet}}
    {{~#case "ARBEID"~}}Arbeid{{~/case~}}
    {{~#case "UTDANNING"~}}Utdanning{{~/case~}}
    {{~#case "KVALPROG"~}}Kvalifiseringsprogram{{~/case~}}
    {{~#case "INTROPROG"~}}Introduksjonsprogram{{~/case~}}
    {{~#case "TRENGER_HJELP"~}}Trenger hjelp{{~/case~}}
    {{~#case "INNLAGT"~}}Innlagt på helseinstitusjon{{~/case~}}
    {{~#case "ARBEID_OG_UTDANNING"~}}Arbeid og utdanning{{~/case~}}
    {{~#case "UFØRE"~}}uføretrygdet{{~/case~}}
    {{~#case "IKKE_OPPGITT"~}}Ikke oppgitt{{~/case~}}
{{/switch}}
{{~/inline~}}
<div class="no-page-break">

## Planen din
{{#if saksnummer~}}
Du har søkt om endring{{#if perioder.0.fom}} fra og med {{norwegian-date perioder.0.fom}}{{/if}}{{#if dekningsgrad}} og har {{dekningsgrad}} prosent dekningsgrad{{/if}}. Planen viser kun endringene du har søkt og ikke det du er innvilget tidligere.
{{~else~}}
{{#if dekningsgrad}}Du har søkt om {{dekningsgrad}} prosent foreldrepenger.{{/if}}
{{~/if}}
{{#if uttaksplan.ønskerJustertUttakVedFødsel}}Perioden som starter på termin blir endret til å starte fra fødselsdato når barnet blir født: {{#eq uttaksplan.ønskerJustertUttakVedFødsel true}}Ja{{else}}Nei{{/eq}}{{/if}}
</div>

{{#each perioder}}
<div class="no-page-break">
{{#eq søker.utsettelseÅrsak "FRI"}}
<strong>Periode uten uttak {{norwegian-date fom}} - {{norwegian-date tom}}</strong>
{{else if søker.utsettelseÅrsak}}
<strong>Utsettelse {{norwegian-date fom}} - {{norwegian-date tom}}</strong>
{{else}}
<strong>{{#if søker.overføringÅrsak}}Overføring av {{/if}}{{> felles-konto}} {{norwegian-date fom}} - {{norwegian-date tom}} ({{antall-virkedager fom tom}} virkedager)</strong>
{{/eq}}
<ul style="margin-top: -10px;">
    <li>{{#if (and søker.kontoType søker.morsAktivitet)}}Hvilken del av foreldrepengene tas ut: {{> felles-konto}} {{#eq søker.morsAktivitet "IKKE_OPPGITT"}}uten{{else}}med{{/eq}} aktivitetskrav{{/if}}</li>
    <li>{{#if (and søker.morsAktivitet (neq søker.morsAktivitet "IKKE_OPPGITT"))}}Mors aktivitet i perioden: {{> felles-mors-aktivitet}}{{/if}}</li>
    {{~#unless søker.utsettelseÅrsak~}}
    <li>{{> utils/sporsmal-svar-ja-nei value=(neq søker.samtidigUttak undefined) label="Skal annen forelder ha foreldrepenger i samme periode"}}</li>
    <li>{{#neq søker.samtidigUttak undefined}}Din prosent med foreldrepenger: {{trim-decimal søker.samtidigUttak}}{{/neq}}</li>
    <li>{{> utils/sporsmal-svar-ja-nei value=søker.flerbarnsdager label="Skal bruke flerbarnsdager"}}</li>
    <li>{{> utils/sporsmal-svar-ja-nei value=(neq søker.gradering undefined) label="Skal kombinere foreldrepengene med arbeid"}}</li>
    {{~/unless~}}
    {{~#with søker.gradering~}}
    <li>{{#eq aktivitet.type "ORDINÆRT_ARBEID"}}Hvor skal du jobbe: {{aktivitet.arbeidsgiverNavn}}{{#if aktivitet.arbeidsgiver.id}} ({{aktivitet.arbeidsgiver.id}}){{/if}}{{/eq}}</li>
    <li>{{#eq aktivitet.type "FRILANS"}}Jobber som: Frilanser{{/eq}}</li>
    <li>{{#eq aktivitet.type "SELVSTENDIG_NÆRINGSDRIVENDE"}}Jobber som: Selvstendig næringsdrivende{{/eq}}</li>
    <li>{{#eq aktivitet.type "ANNET"}}Jobber som: Annet{{/eq}}</li>
    <li>Oppgitt prosent i arbeid: {{trim-decimal arbeidstidprosent}}</li>
    {{~/with~}}
    <li>{{#if søker.overføringÅrsak}}Årsak til overføring av kvote: {{#switch søker.overføringÅrsak}}
        {{~#case "INSTITUSJONSOPPHOLD_ANNEN_FORELDER"~}}Annen forelder er innlagt på helseinstitusjon{{~/case~}}
        {{~#case "SYKDOM_ANNEN_FORELDER"~}}Annen forelder er for syk til å ta seg av barnet{{~/case~}}
        {{~#case "ALENEOMSORG"~}}Aleneomsorg{{~/case~}}
        {{~#case "IKKE_RETT_ANNEN_FORELDER"~}}Annen forelder har ikke rett til foreldrepenger{{~/case~}}
    {{/switch}}{{/if}}</li>
    <li>{{#if (and søker.utsettelseÅrsak (neq søker.utsettelseÅrsak "FRI"))}}Årsak til utsettelse: {{#switch søker.utsettelseÅrsak}}
        {{~#case "ARBEID"~}}Arbeid{{~/case~}}
        {{~#case "FERIE"~}}Ferie{{~/case~}}
        {{~#case "SØKER_SYKDOM"~}}Jeg er for syk til å ta meg av barnet{{~/case~}}
        {{~#case "SØKER_INNLAGT"~}}Jeg er innlagt på helseinstitusjon{{~/case~}}
        {{~#case "BARN_INNLAGT"~}}Barnet er innlagt på helseinstitusjon{{~/case~}}
        {{~#case "HV_ØVELSE"~}}Øvelse i Heimevernet{{~/case~}}
        {{~#case "NAV_TILTAK"~}}Tiltakspenger Nav{{~/case~}}
    {{/switch}}{{/if}}</li>
</ul>
</div>
{{/each}}
